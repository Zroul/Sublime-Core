{
  "name": "sublime-core",
  "version": "0.1.0",
  "private": true,
  "description": "Private AI-powered assistant for Sublime Core",
  "type": "module",
  "scripts": {
    "start": "node app/backend/index.js",
    "nova:research": "tsx core/ai/reasoning/run-test.ts",
    "core:chat": "tsx core/ai/reasoning/run-core-chat.ts",
    "obsidian:ai": "tsx obsidian/backend/core/ai-server.ts",
    "nova": "tsx core/nova/run.ts",
    "nova:test": "node core/nova/test-runner.mjs",
    "obsidian:test": "node --test obsidian/backend/host/host.test.cjs obsidian/backend/core/planner.test.mjs obsidian/backend/core/knowledge.test.mjs obsidian/backend/core/creative-retrieval.test.mjs obsidian/backend/core/ollama-status.test.mjs obsidian/backend/core/style-recipes.test.mjs obsidian/backend/core/host-bridge.test.cjs obsidian/backend/core/creative-recipes.test.cjs obsidian/backend/core/captions.test.mjs obsidian/backend/core/caption-progress.test.cjs obsidian/backend/core/transcription.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.10.0"
  }
}
